@page "/"
@model ReleaseReadinessCoordinator.Pages.Releases.NewModel
@{
    ViewData["Title"] = "Release workflows";
    var testEvidenceAvailable = Model.Input.IncludeTestEvidence;
    var securityEvidenceAvailable = Model.Input.IncludeSecurityEvidence;
    var changeEvidenceAvailable = Model.Input.IncludeChangeEvidence;
}

<h1>Release workflows</h1>

<section class="detail-section mb-4" aria-labelledby="continue-workflow-heading">
    <h2 id="continue-workflow-heading">Continue existing workflow</h2>
    <p>Enter a release ID to open its active remediation or decision request, or view its current status.</p>
    <form method="get">
        <label asp-for="ExistingReleaseId" class="form-label"></label>
        <div class="input-group">
            <input asp-for="ExistingReleaseId" class="form-control" required aria-required="true" />
            <button type="submit" class="btn btn-primary">Continue workflow</button>
        </div>
        <span asp-validation-for="ExistingReleaseId" class="text-danger"></span>
    </form>
</section>

<section aria-labelledby="submit-release-heading">
    <h2 id="submit-release-heading">Submit release</h2>

    <p>Load a local fixture, review the values, then submit it as a new immutable release.</p>
    <div class="mb-4 d-flex flex-wrap gap-2">
        @foreach (var fixture in Model.Fixtures)
        {
            <a class="btn btn-outline-secondary" asp-page="/Releases/New" asp-route-fixture="@fixture.Key">
                Load @fixture.Name
            </a>
        }
    </div>

    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <p><span class="text-danger" aria-hidden="true">*</span> Required release metadata fields must be completed.</p>

    <fieldset class="mb-4">
        <legend>Immutable release metadata</legend>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.ReleaseId" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
                <input asp-for="Input.ReleaseId" class="form-control" aria-required="true" />
                <span asp-validation-for="Input.ReleaseId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.ServiceName" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
                <input asp-for="Input.ServiceName" class="form-control" aria-required="true" />
                <span asp-validation-for="Input.ServiceName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.ReleaseVersion" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
                <input asp-for="Input.ReleaseVersion" class="form-control" aria-required="true" />
                <span asp-validation-for="Input.ReleaseVersion" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.DeploymentWindowStart" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
                <input asp-for="Input.DeploymentWindowStart" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control" aria-required="true" />
            </div>
            <div class="col-md-4">
                <label asp-for="Input.DeploymentWindowEnd" class="form-label"></label> <span class="text-danger" aria-hidden="true">*</span>
                <input asp-for="Input.DeploymentWindowEnd" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control" aria-required="true" />
            </div>
        </div>
    </fieldset>

    <p class="small"><span class="text-danger" aria-hidden="true">*</span> Required when evidence is available. Optional list fields may be left blank when there are no items.</p>

    <fieldset class="mb-4 border rounded p-3">
        <legend class="float-none w-auto px-2 fs-5">Test evidence</legend>
        <div class="form-check mb-2">
            <input asp-for="Input.IncludeTestEvidence" class="form-check-input" data-evidence-availability aria-controls="test-evidence-fields" aria-describedby="test-evidence-help" aria-expanded="@testEvidenceAvailable.ToString().ToLowerInvariant()" />
            <label asp-for="Input.IncludeTestEvidence" class="form-check-label">Evidence available now</label>
        </div>
        <p id="test-evidence-help" class="small text-secondary">Select this when Test evidence is ready to submit. Otherwise, provide it during remediation.</p>
        <div id="test-evidence-fields" class="row g-3" data-evidence-fields hidden="@(!testEvidenceAvailable ? "hidden" : null)">
            <div class="col-md-4"><label asp-for="Input.TestRunVersion" class="form-label">Test run version <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Input.TestRunVersion" class="form-control" data-required-when-available required="@(testEvidenceAvailable ? "required" : null)" aria-required="@testEvidenceAvailable.ToString().ToLowerInvariant()" disabled="@(!testEvidenceAvailable ? "disabled" : null)" /><span asp-validation-for="Input.TestRunVersion" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Input.TestCompletedAt" class="form-label">Completed at <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Input.TestCompletedAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control" data-required-when-available required="@(testEvidenceAvailable ? "required" : null)" aria-required="@testEvidenceAvailable.ToString().ToLowerInvariant()" disabled="@(!testEvidenceAvailable ? "disabled" : null)" /><span asp-validation-for="Input.TestCompletedAt" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Input.TestPassRatePercent" class="form-label">Pass rate (%) <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Input.TestPassRatePercent" class="form-control" data-required-when-available required="@(testEvidenceAvailable ? "required" : null)" aria-required="@testEvidenceAvailable.ToString().ToLowerInvariant()" disabled="@(!testEvidenceAvailable ? "disabled" : null)" /><span asp-validation-for="Input.TestPassRatePercent" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Input.CriticalSuiteFailures" class="form-label">Critical suite failures</label><textarea asp-for="Input.CriticalSuiteFailures" class="form-control" rows="2" disabled="@(!testEvidenceAvailable ? "disabled" : null)"></textarea><div class="form-text">Comma-separated suite names; leave blank for none.</div><span asp-validation-for="Input.CriticalSuiteFailures" class="text-danger"></span></div>
        </div>
    </fieldset>

    <fieldset class="mb-4 border rounded p-3">
        <legend class="float-none w-auto px-2 fs-5">Security evidence</legend>
        <div class="form-check mb-2">
            <input asp-for="Input.IncludeSecurityEvidence" class="form-check-input" data-evidence-availability aria-controls="security-evidence-fields" aria-describedby="security-evidence-help" aria-expanded="@securityEvidenceAvailable.ToString().ToLowerInvariant()" />
            <label asp-for="Input.IncludeSecurityEvidence" class="form-check-label">Evidence available now</label>
        </div>
        <p id="security-evidence-help" class="small text-secondary">Select this when Security evidence is ready to submit. Otherwise, provide it during remediation.</p>
        <div id="security-evidence-fields" class="row g-3" data-evidence-fields hidden="@(!securityEvidenceAvailable ? "hidden" : null)">
            <div class="col-md-6"><label asp-for="Input.SecurityScanVersion" class="form-label">Scan version <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Input.SecurityScanVersion" class="form-control" data-required-when-available required="@(securityEvidenceAvailable ? "required" : null)" aria-required="@securityEvidenceAvailable.ToString().ToLowerInvariant()" disabled="@(!securityEvidenceAvailable ? "disabled" : null)" /><span asp-validation-for="Input.SecurityScanVersion" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Input.SecurityScannedAt" class="form-label">Scanned at <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Input.SecurityScannedAt" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control" data-required-when-available required="@(securityEvidenceAvailable ? "required" : null)" aria-required="@securityEvidenceAvailable.ToString().ToLowerInvariant()" disabled="@(!securityEvidenceAvailable ? "disabled" : null)" /><span asp-validation-for="Input.SecurityScannedAt" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Input.CriticalFindingIds" class="form-label">Unresolved critical finding IDs</label><textarea asp-for="Input.CriticalFindingIds" class="form-control" rows="2" disabled="@(!securityEvidenceAvailable ? "disabled" : null)"></textarea><div class="form-text">Comma-separated IDs; leave blank for none.</div><span asp-validation-for="Input.CriticalFindingIds" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="Input.HighFindingIds" class="form-label">Unresolved high finding IDs</label><textarea asp-for="Input.HighFindingIds" class="form-control" rows="2" disabled="@(!securityEvidenceAvailable ? "disabled" : null)"></textarea><div class="form-text">Comma-separated IDs; leave blank for none.</div><span asp-validation-for="Input.HighFindingIds" class="text-danger"></span></div>
            <div class="col-12"><label asp-for="Input.SecurityExceptions" class="form-label">Approved exceptions</label><textarea asp-for="Input.SecurityExceptions" class="form-control" rows="2" disabled="@(!securityEvidenceAvailable ? "disabled" : null)"></textarea><div class="form-text">One per line: <code>finding-id|scope|YYYY-MM-DD HH:mm:ss</code> using local time. Leave blank for none.</div><span asp-validation-for="Input.SecurityExceptions" class="text-danger"></span></div>
        </div>
    </fieldset>

    <fieldset class="mb-4 border rounded p-3">
        <legend class="float-none w-auto px-2 fs-5">Change evidence</legend>
        <div class="form-check mb-2">
            <input asp-for="Input.IncludeChangeEvidence" class="form-check-input" data-evidence-availability aria-controls="change-evidence-fields" aria-describedby="change-evidence-help" aria-expanded="@changeEvidenceAvailable.ToString().ToLowerInvariant()" />
            <label asp-for="Input.IncludeChangeEvidence" class="form-check-label">Evidence available now</label>
        </div>
        <p id="change-evidence-help" class="small text-secondary">Select this when Change approval evidence is ready to submit. Otherwise, provide it during remediation.</p>
        <div id="change-evidence-fields" class="row g-3 align-items-end" data-evidence-fields hidden="@(!changeEvidenceAvailable ? "hidden" : null)">
            <div class="col-md-4">
                <div class="form-check mb-2"><input asp-for="Input.ChangeApproved" class="form-check-input" disabled="@(!changeEvidenceAvailable ? "disabled" : null)" /><label asp-for="Input.ChangeApproved" class="form-check-label">Change approved</label></div>
            </div>
            <div class="col-md-4"><label asp-for="Input.ChangeWindowStart" class="form-label">Approved window start <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Input.ChangeWindowStart" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control" data-required-when-available required="@(changeEvidenceAvailable ? "required" : null)" aria-required="@changeEvidenceAvailable.ToString().ToLowerInvariant()" disabled="@(!changeEvidenceAvailable ? "disabled" : null)" /><span asp-validation-for="Input.ChangeWindowStart" class="text-danger"></span></div>
            <div class="col-md-4"><label asp-for="Input.ChangeWindowEnd" class="form-label">Approved window end <span class="text-danger" aria-hidden="true">*</span></label><input asp-for="Input.ChangeWindowEnd" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm:ss}" step="1" class="form-control" data-required-when-available required="@(changeEvidenceAvailable ? "required" : null)" aria-required="@changeEvidenceAvailable.ToString().ToLowerInvariant()" disabled="@(!changeEvidenceAvailable ? "disabled" : null)" /><span asp-validation-for="Input.ChangeWindowEnd" class="text-danger"></span></div>
        </div>
    </fieldset>

    <button type="submit" class="btn btn-primary">Submit and start workflow</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            document.querySelectorAll("[data-evidence-availability]").forEach(toggle => {
                const fields = document.getElementById(toggle.getAttribute("aria-controls"));
                const inputs = fields.querySelectorAll("input, textarea, select");

                const updateAvailability = () => {
                    const available = toggle.checked;
                    fields.hidden = !available;
                    toggle.setAttribute("aria-expanded", available.toString());
                    inputs.forEach(input => {
                        input.disabled = !available;
                        if (input.hasAttribute("data-required-when-available")) {
                            input.required = available;
                            input.setAttribute("aria-required", available.toString());
                        }
                    });
                };

                toggle.addEventListener("change", updateAvailability);
                updateAvailability();
            });
        })();
    </script>
}
